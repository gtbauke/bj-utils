{
    "manifest_version": 3,
    "name": "BJ Utils",
    "version": "1.0",
    "content_scripts": [
        {
            "matches": [
                "https://*.brasiljunior.org.br/*"
            ],
            "js": [
                "js/content.js"
            ]
        }
    ],
    "permissions": [
        "webRequest",
        "storage"
    ],
    "host_permissions": [
        "https://portal.brasiljunior.org.br/*",
        "https://api.brasiljunior.org.br/*"
    ],
    "background": {
        "service_worker": "js/background.js"
    }
}
